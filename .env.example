# PostgreSQL connection string (required)
# Format: postgres://user:password@host:5432/database
DATABASE_URL=postgres://user:password@localhost:5432/smartcart

# Port for the API server (auto-assigned in Replit; set manually for local dev)
PORT=8082

# Comma-separated list of allowed CORS origins for the API (optional)
# Example: https://myapp.replit.app,https://myapp.com
ALLOWED_ORIGINS=
